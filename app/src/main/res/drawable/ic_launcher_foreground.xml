<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Two round-capped tide bands. Thickness comes from the stroke rather than a
      filled outline, which keeps the shape readable down to 24px. Both bands sit
      inside the 72dp visible circle, so no launcher mask clips them.
    -->
    <path
        android:pathData="M27,65 C39,65 44,55 54,55 C64,55 69,65 81,65"
        android:strokeColor="#FF8FC4EC"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
    <path
        android:pathData="M27,49 C39,49 44,39 54,39 C64,39 69,49 81,49"
        android:strokeColor="#FFF8FCFF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
</vector>
